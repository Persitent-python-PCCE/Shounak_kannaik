pipeline {
    agent any

    stages {
        stage('Test Email') {
            steps {
                echo 'Testing email...'
            }
        }
    }

    post {
        always {
            emailext(
                to: 'YOUR_EMAIL@gmail.com',
                subject: 'Jenkins Email Test',
                body: 'If you received this email, Jenkins SMTP is working!'
            )
        }
    }
}
