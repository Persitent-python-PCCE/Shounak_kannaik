pipeline {
    agent any

    stages {

        stage('Verify Project') {
            steps {
                dir('Projects/project_1') {
                    sh '''
                        echo "Project directory:"
                        pwd

                        echo "Project files:"
                        ls -la

                        echo "Checking required files:"
                        test -f Dockerfile
                        test -f requirements.txt
                        test -f app.py

                        echo "All required files found."
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Projects/project_1') {
                    sh '''
                        docker build \
                            -t shonk673/flask-app:latest \
                            .
                    '''
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'dockerhub-creds'
                    ) {
                        sh '''
                            docker push shonk673/flask-app:latest
                        '''
                    }
                }
            }
        }
    }
}